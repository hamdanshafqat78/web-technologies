<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product — RoyalTag Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/admin.css">
</head>
<body>
<div class="admin-wrapper">

    <%- include('../partials/admin-sidebar', { activeSidebar: 'add' }) %>

    <!-- ===== MAIN ===== -->
    <main class="admin-main">
        <div class="admin-topbar">
            <div>
                <h1>Add New Product</h1>
                <p class="breadcrumb"><a href="/admin">Admin</a> / <a href="/admin">Dashboard</a> / Add Product</p>
            </div>
        </div>

        <div class="admin-content">

            <!-- Flash Messages -->
            <% if(error && error.length) { %>
            <div class="flash-error-bar">⚠️ <%= error[0] %></div>
            <% } %>

            <div class="form-card">
                <h2>📦 New Product Details</h2>

                <form method="POST" action="/admin/products/add" enctype="multipart/form-data" id="add-product-form" novalidate>

                    <div class="form-grid">
                        <div class="admin-form-group full-width">
                            <label for="name">Product Name *</label>
                            <input type="text" id="name" name="name" placeholder="e.g. Premium Polo Shirt" required maxlength="120">
                        </div>

                        <div class="admin-form-group">
                            <label for="price">Price (USD) *</label>
                            <input type="number" id="price" name="price" placeholder="e.g. 49.99" min="0" step="0.01" required>
                        </div>

                        <div class="admin-form-group">
                            <label for="category">Category *</label>
                            <select id="category" name="category" required>
                                <option value="">-- Select Category --</option>
                                <% categories.forEach(cat => { %>
                                <option value="<%= cat %>"><%= cat %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="admin-form-group">
                            <label for="rating">Rating (0–5) *</label>
                            <input type="number" id="rating" name="rating" placeholder="e.g. 4.5" min="0" max="5" step="0.1" required>
                        </div>

                        <div class="admin-form-group">
                            <label for="stock">Stock Quantity *</label>
                            <input type="number" id="stock" name="stock" placeholder="e.g. 100" min="0" required>
                        </div>

                        <div class="admin-form-group full-width">
                            <label for="description">Description</label>
                            <textarea id="description" name="description" placeholder="Short product description (optional)..."></textarea>
                        </div>

                        <div class="admin-form-group full-width">
                            <label for="image">Product Image</label>
                            <input type="file" id="image" name="image" accept="image/jpeg,image/jpg,image/png,image/webp">
                            <div class="img-preview-wrap" id="img-preview-wrap" style="display:none;">
                                <img id="img-preview" src="" alt="Preview">
                                <p>Image preview</p>
                            </div>
                            <p style="font-size:0.78rem;color:#888;margin-top:6px;">Accepted: JPG, PNG, WEBP. Max 5MB.</p>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-save">💾 Save Product</button>
                        <a href="/admin" class="btn-cancel">✕ Cancel</a>
                    </div>
                </form>
            </div>

        </div>
    </main>
</div>

<script>
document.getElementById('image').addEventListener('change', function () {
    var file = this.files[0];
    var wrap = document.getElementById('img-preview-wrap');
    var preview = document.getElementById('img-preview');
    if (file) {
        var reader = new FileReader();
        reader.onload = function (e) { preview.src = e.target.result; wrap.style.display = 'block'; };
        reader.readAsDataURL(file);
    } else { wrap.style.display = 'none'; }
});

document.getElementById('add-product-form').addEventListener('submit', function (e) {
    var name = document.getElementById('name').value.trim();
    var price = document.getElementById('price').value;
    var category = document.getElementById('category').value;
    var rating = document.getElementById('rating').value;
    var stock = document.getElementById('stock').value;
    if (!name || !price || !category || !rating || !stock) {
        e.preventDefault(); alert('⚠️ Please fill in all required fields.'); return false;
    }
    if (parseFloat(rating) < 0 || parseFloat(rating) > 5) {
        e.preventDefault(); alert('⚠️ Rating must be between 0 and 5.'); return false;
    }
});
</script>
</body>
</html>
