<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login — RoyalTag</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <style>
        body { background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .admin-login-card { background: #fff; border-radius: 10px; padding: 52px 44px; width: 100%; max-width: 420px; box-shadow: 0 20px 60px rgba(0,0,0,0.4); }
        .admin-login-brand { text-align: center; margin-bottom: 32px; }
        .admin-login-brand .logo-text { font-size: 1.8rem; display: block; margin-bottom: 6px; }
        .admin-login-brand p { color: #888; font-size: 0.88rem; }
        .admin-badge { display: inline-block; background: #e8b86d22; color: #e8b86d; border: 1px solid #e8b86d55; padding: 4px 14px; border-radius: 20px; font-size: 0.78rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 18px; }
        .flash-error { background: #fee2e2; color: #dc2626; padding: 12px 16px; border-radius: 6px; margin-bottom: 20px; font-size: 0.88rem; border-left: 4px solid #dc2626; }
        .admin-form { display: flex; flex-direction: column; gap: 18px; }
        .form-group { display: flex; flex-direction: column; gap: 7px; }
        .form-group label { font-size: 0.85rem; font-weight: 700; color: #1a1a2e; }
        .form-group input { padding: 12px 14px; border: 1.5px solid #ddd; border-radius: 6px; font-size: 0.95rem; font-family: inherit; outline: none; transition: border-color 0.2s; }
        .form-group input:focus { border-color: #e8b86d; }
        .btn-admin-login { width: 100%; background: #1a1a2e; color: #fff; border: none; padding: 14px; font-size: 0.95rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; border-radius: 6px; transition: background 0.25s; margin-top: 4px; }
        .btn-admin-login:hover { background: #e8b86d; color: #1a1a2e; }
        .back-link { text-align: center; margin-top: 20px; font-size: 0.85rem; color: #888; }
        .back-link a { color: #e8b86d; font-weight: 600; }
        .hint-box { background: #f8f9fa; border: 1px dashed #ddd; border-radius: 6px; padding: 12px 16px; margin-top: 20px; font-size: 0.8rem; color: #888; }
        .hint-box strong { color: #1a1a2e; display: block; margin-bottom: 4px; }
    </style>
</head>
<body>
    <div class="admin-login-card">
        <div class="admin-login-brand">
            <span class="logo-text">RoyalTag</span>
            <span class="admin-badge">🔐 Admin Panel</span>
            <p>Sign in to manage your store</p>
        </div>

        <% if (error && error.length) { %>
        <div class="flash-error">⚠️ <%= error[0] %></div>
        <% } %>

        <form class="admin-form" method="POST" action="/admin/login">
            <div class="form-group">
                <label for="admin-email">Admin Email</label>
                <input type="email" id="admin-email" name="email" placeholder="admin@royaltag.com" required autocomplete="email">
            </div>
            <div class="form-group">
                <label for="admin-password">Password</label>
                <input type="password" id="admin-password" name="password" placeholder="Enter password" required>
            </div>
            <button type="submit" class="btn-admin-login">Login to Admin Panel</button>
        </form>

        <div class="hint-box">
            <strong>Demo Credentials</strong>
            Email: admin@royaltag.com &nbsp;|&nbsp; Password: admin123
        </div>

        <p class="back-link"><a href="/">&larr; Back to Store</a></p>
    </div>
</body>
</html>
