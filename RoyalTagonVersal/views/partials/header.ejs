<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'RoyalTag - Premium Fashion & Lifestyle Store' %>">
    <title>
        <%= typeof pageTitle !=='undefined' ? pageTitle : 'RoyalTag' %>
    </title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">

    <!-- Site CSS -->
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar">
        <div class="nav-container">
            <a class="logo" href="/">
                <img src="/images/logo.png" alt="RoyalTag Logo">
                <span class="logo-text">RoyalTag</span>
            </a>

            <button class="hamburger" id="hamburger-btn" aria-label="Toggle Menu" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <ul class="nav-links" id="nav-menu">
                <li><a href="/" class="<%= activePage === 'home'     ? 'active' : '' %>">Home</a></li>
                <li><a href="/products" class="<%= activePage === 'products' ? 'active' : '' %>">Products</a></li>
                <li><a href="/cart" class="<%= activePage === 'cart'     ? 'active' : '' %>">Cart</a></li>
                <li><a href="/onsale-products" class="<%= activePage === 'onsale' ? 'active' : '' %> nav-onsale-link">🏷️ On Sale</a></li>


                <% if (currentUser) { %>
                    <!-- Logged-in user links -->
                    <% if (currentUser.role==='admin' ) { %>
                        <li><a href="/admin" class="nav-admin-link">🔐 Admin Panel</a></li>
                        <% } %>
                            <li><a href="/profile" class="<%= activePage === 'profile' ? 'active' : '' %>">👤 <%=
                                        currentUser.name %></a></li>
                            <li><a href="/logout" class="nav-logout-link">Logout</a></li>
                            <% } else { %>
                                <!-- Guest links -->
                                <li><a href="/login" class="<%= activePage === 'login'    ? 'active' : '' %>">Login</a>
                                </li>
                                <li><a href="/register"
                                        class="<%= activePage === 'register' ? 'active' : '' %>">Register</a></li>
                                <% } %>
            </ul>
        </div>
    </nav>

    <!-- ===== FLASH MESSAGES ===== -->
    <% if (success && success.length) { %>
        <div class="flash-bar flash-bar-success">
            <span>✅ <%= success[0] %></span>
            <button class="flash-close" onclick="this.parentElement.remove()">&times;</button>
        </div>
        <% } %>
            <% if (error && error.length) { %>
                <div class="flash-bar flash-bar-error">
                    <span>⚠️ <%= error[0] %></span>
                    <button class="flash-close" onclick="this.parentElement.remove()">&times;</button>
                </div>
                <% } %>