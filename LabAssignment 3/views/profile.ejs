
<%- include('partials/header', {
        activePage: 'profile',
        pageTitle:  'RoyalTag — My Profile',
        metaDesc:   'Your RoyalTag account profile.'
    }) %>

    <!-- ===== PROFILE SECTION ===== -->
    <section class="login-section">
        <div class="login-card profile-card">

            <div class="login-header">
                <div class="profile-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
                <h1><%= user.name %></h1>
                <p class="profile-role-badge role-<%= user.role %>"><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></p>
            </div>

            <div class="profile-details">
                <div class="profile-row">
                    <span class="profile-label">📧 Email</span>
                    <span class="profile-value"><%= user.email %></span>
                </div>
                <div class="profile-row">
                    <span class="profile-label">📅 Member Since</span>
                    <span class="profile-value"><%= user.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                </div>
                <div class="profile-row">
                    <span class="profile-label">🔑 Role</span>
                    <span class="profile-value"><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></span>
                </div>
            </div>

            <div class="profile-actions">
                <a href="/" class="btn-outline">← Back to Store</a>
                <% if (user.role === 'admin') { %>
                <a href="/admin" class="btn-primary">🔐 Admin Panel</a>
                <% } %>
                <a href="/logout" class="btn-logout-profile">Logout</a>
            </div>

        </div>
    </section>

<%- include('partials/footer') %>
